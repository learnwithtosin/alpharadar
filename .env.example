# AlphaRadar — Environment Contract
# Authoritative source: docs/spec/09-INFRASTRUCTURE-DECISION.md §9
# (supersedes docs/spec/05-ENVIRONMENT-CONTRACT.md — do not use that file's list)
#
# Copy this file to `.env` for local development. Never commit a real `.env`.

NODE_ENV=development
WEB_URL=http://localhost:3000
AUTH_SECRET=

# Supabase Postgres
# DATABASE_URL must keep ?pgbouncer=true (disables Prisma's prepared
# statements, required against PgBouncer's transaction pooling mode) plus
# &pool_timeout=10 — without these, Prisma's own client-side pool defaults
# to num_cpus*2+1 connections per process (17 on an 8-core box), needlessly
# competing for PgBouncer's own, separately-sized pool; Prisma's documented
# PgBouncer guidance is to keep the client-side pool small since PgBouncer
# already pools server-side. See
# docs/decisions/0020-db-pooler-retry-budget-and-pool-config.md.
#
# connection_limit differs by deployment target, not one shared value:
# - apps/pipeline (GitHub Actions, one process per run): connection_limit=5,
#   unchanged from decision 0020 — no evidence 5 causes harm there.
# - apps/web (Vercel, many concurrent serverless function invocations, each
#   its own process/connection): connection_limit=1 — Supabase's own
#   documented recommendation for serverless/edge deployments ("In
#   serverless setups, begin with connection_limit=1, increasing cautiously
#   if needed"). At 5, N concurrent invocations can reach 5N connections
#   against the pooler; this value must be set directly in the Vercel
#   dashboard's environment variables, not here — this file is local-dev
#   only. See docs/decisions/0023-vercel-missing-engine-and-web-retry-budget.md.
DATABASE_URL=            # local dev: pooled connection, port 6543, ?pgbouncer=true&connection_limit=5&pool_timeout=10
DIRECT_URL=              # direct connection, port 5432, for migrations

# Pipeline driver — see docs/spec/09-INFRASTRUCTURE-DECISION.md §11
RUN_MODE=poll                   # poll | stream

# Robinhood Chain
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_WS_URL=               # unused while RUN_MODE=poll
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Telegram
TELEGRAM_BOT_TOKEN=

# Pipeline controls
POLL_BLOCK_CHUNK_SIZE=1000
MAX_BLOCKS_PER_RUN=500           # most-recent blocks scanned for new-contract discovery per run; sized from whole-run cost (startup + 305ms/block scan + 7s/candidate post-scan at a pessimistic 10 candidates) to land ~227s worst case, comfortably under the 5-min cron; older blocks are skipped, not backfilled — not in 09 §9, added when discovery moved off the Blockscout verified-contracts feed; pair with a 5-minute GitHub Actions cron, not 10 — see docs/decisions/0011-discovery-method-switch.md
ALERT_MIN_SCORE=60
ALERT_MAX_PER_USER_PER_HOUR=6
ALERT_DEDUPE_WINDOW_HOURS=24     # same project + actionProfile cannot alert twice within this window (08 §4.4); not prescribed by spec, a judgment call — see packages/config/src/env.ts
AI_ENABLED=false
AI_PROVIDER=claude
AI_API_KEY=
AI_MIN_SCORE_TO_ANALYZE=70

LOG_LEVEL=info
