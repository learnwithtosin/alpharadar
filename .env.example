# AlphaRadar — Environment Contract
# Authoritative source: docs/spec/09-INFRASTRUCTURE-DECISION.md §9
# (supersedes docs/spec/05-ENVIRONMENT-CONTRACT.md — do not use that file's list)
#
# Copy this file to `.env` for local development. Never commit a real `.env`.

NODE_ENV=development
WEB_URL=http://localhost:3000
AUTH_SECRET=

# Supabase Postgres
DATABASE_URL=            # pooled connection, port 6543, ?pgbouncer=true
DIRECT_URL=              # direct connection, port 5432, for migrations

# Pipeline driver — see docs/spec/09-INFRASTRUCTURE-DECISION.md §11
RUN_MODE=poll                   # poll | stream

# Robinhood Chain
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_WS_URL=               # unused while RUN_MODE=poll
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Telegram
TELEGRAM_BOT_TOKEN=

# Pipeline controls
POLL_BLOCK_CHUNK_SIZE=1000
MAX_BLOCKS_PER_RUN=150           # most-recent blocks scanned for new-contract discovery per run; older blocks are skipped, not backfilled — not in 09 §9, added when discovery moved off the Blockscout verified-contracts feed
ALERT_MIN_SCORE=60
ALERT_MAX_PER_USER_PER_HOUR=6
AI_ENABLED=false
AI_PROVIDER=claude
AI_API_KEY=
AI_MIN_SCORE_TO_ANALYZE=70

LOG_LEVEL=info
